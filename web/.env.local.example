# Supabase (Settings -> API in your Supabase project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key - server-only, bypasses RLS. Used by the checkout and
# webhook routes to write payments/subscriptions. NEVER expose this to the
# browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Paystack (Settings -> API Keys & Webhooks in your Paystack dashboard)
# Use your sk_test_... key while testing - Paystack uses one API base URL
# for both test and live, distinguished only by which key you use.
PAYSTACK_SECRET_KEY=

# Your deployed app's URL, no trailing slash (e.g. https://yourapp.vercel.app).
# Used as the magic-link redirect base.
NEXT_PUBLIC_APP_URL=http://localhost:3000
